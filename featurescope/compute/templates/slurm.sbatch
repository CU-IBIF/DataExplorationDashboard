#!/bin/bash
#SBATCH --job-name=${job_name}
#SBATCH --partition=${partition}
#SBATCH --cpus-per-task=${cpus}
#SBATCH --mem=${mem}
#SBATCH --time=${time}
#SBATCH --output=${workdir}/slurm-%j.out
${gres_line}
${account_line}
${extra_sbatch}
# Generated by FeatureScope. Runs the pipeline against the staged project; every
# finished step lands in ../../cache/<key>/ so partial progress survives a timeout
# and resubmitting continues where it stopped.
set -euo pipefail
cd ${workdir}
${env_setup}
export OMP_NUM_THREADS=$${SLURM_CPUS_PER_TASK:-1}
export NUMBA_NUM_THREADS=$${SLURM_CPUS_PER_TASK:-1}
echo "host $$(hostname)  gpus: $${CUDA_VISIBLE_DEVICES:-none}"
${run_cmd}
