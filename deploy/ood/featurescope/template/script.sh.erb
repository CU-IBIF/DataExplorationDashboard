#!/usr/bin/env bash
# Open OnDemand proxies the app at /rnode/<host>/<port>/ ; FeatureScope uses relative URLs,
# so --root-path makes generated links correct behind the proxy.
module load apptainer 2>/dev/null || true
SIF=${FEATURESCOPE_SIF:-$HOME/featurescope-gpu.sif}
NV=""; [ "<%= gpus %>" != "0" ] && NV="--nv"
apptainer exec $NV "$SIF" featurescope serve --host 0.0.0.0 --port "$port" \
  --root-path "/rnode/$(hostname)/$port" --workspace "<%= workspace %>"
